{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["tools/map-editor/src/**/*.ts", "tools/map-editor/tests/**/*.ts", "tests/**/*.ts"]
}
