{
  "name": "1400-dev-tool",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/serve.ts",
    "build:asset": "node --experimental-strip-types src/projects/build-cli.ts",
    "inspect": "node --experimental-strip-types tools/map-editor/src/cli.ts",
    "test": "node --experimental-strip-types --test tools/map-editor/tests/*.test.ts tests/*.test.ts",
    "test:build": "node --experimental-strip-types --test tests/build-pipeline.test.ts",
    "test:styles:quick": "node --experimental-strip-types --test --test-name-pattern=\"naturalistic and watercolor\" tests/material-style-generation.test.ts tests/clay-style-generation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "description": "Local browser-based development tools for 1400",
  "dependencies": {
    "three": "0.180.0"
  }
}
